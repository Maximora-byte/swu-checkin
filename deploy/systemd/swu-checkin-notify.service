[Unit]
Description=Send the daily SWU check-in result to Telegram
Documentation=https://github.com/Maximora-byte/swu-checkin
After=network-online.target swu-checkin.service
Wants=network-online.target

[Service]
Type=oneshot
# OpenClaw is installed for root and reads root-owned channel configuration/state.
User=root
Group=swu-checkin
WorkingDirectory=/opt/swu-checkin
EnvironmentFile=/etc/swu-checkin/notify.env
Environment=TZ=Asia/Shanghai
Environment=SWUDK_STATE_DIR=/var/lib/swu-checkin
Environment=SWUDK_NOTIFY_CHANNEL=telegram
Environment=SWUDK_NOTIFY_ACCOUNT=default
Environment=XDG_CACHE_HOME=/var/cache/swu-checkin
ExecStart=/opt/swu-checkin/.venv/bin/swu-checkin-notify
CacheDirectory=swu-checkin
CacheDirectoryMode=0700
UMask=0077
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/swu-checkin /root/.openclaw/state
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
