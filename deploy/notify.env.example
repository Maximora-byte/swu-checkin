# Copy to /etc/swu-checkin/notify.env and keep it mode 0600, owned by root.
SWUDK_NOTIFY_TARGET="your-telegram-chat-id"

# Child CLI deadline including cold startup (integer 30..180 seconds; default 120).
# Keep systemd TimeoutStartSec > timeout + cleanup grace + startup overhead.
# For 180 seconds use at least 210 seconds; the service default is 210 seconds.
SWUDK_NOTIFY_SEND_TIMEOUT=120
# Dry-run never writes or consumes real daily attempt/completion markers.
# SWUDK_NOTIFY_DRY_RUN=1
