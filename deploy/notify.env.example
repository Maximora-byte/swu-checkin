# Copy to /etc/swu-checkin/notify.env and keep it mode 0600, owned by root.
SWUDK_NOTIFY_TARGET="your-telegram-chat-id"

# Child CLI deadline including cold startup (integer 30..180 seconds; default 120).
# Keep systemd TimeoutStartSec > timeout + cleanup grace + startup overhead.
# For 180 seconds use at least 210 seconds; the service default is 210 seconds.
SWUDK_NOTIFY_SEND_TIMEOUT=120
# Dry-run never writes or consumes real daily attempt/completion markers.
# SWUDK_NOTIFY_DRY_RUN=1

# Optional alternative to Telegram. Select exactly one transport per invocation.
# Email uses independent daily markers; SMTP acceptance is not delivery proof.
# SWUDK_NOTIFY_CHANNEL=email
# SWUDK_NOTIFY_TARGET=recipient@example.invalid
# SWUDK_SMTP_HOST=smtp.example.invalid
# SWUDK_SMTP_SECURITY=starttls
# SWUDK_SMTP_PORT=587
# SWUDK_SMTP_FROM=sender@example.invalid
# SWUDK_SMTP_USERNAME=your-smtp-user
# SWUDK_SMTP_PASSWORD=SET_USING_YOUR_SECRET_MANAGER
# SWUDK_SMTP_TIMEOUT=30
# Only starttls or ssl (default port 465) allowed; certificates are verified.
# No plaintext SMTP or automatic retries after uncertain sends.
# SMTP_TIMEOUT bounds each network operation; the parent SEND_TIMEOUT bounds total runtime.
